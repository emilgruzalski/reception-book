{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "validIssuer": "ReceptionBookAPI",
    "validAudience": "ReceptionBookClient",
    "expiresInMinutes": 15,
    "refreshTokenExpiresInDays": 7
  },
  "RateLimiting": {
    "authenticationPermitLimit": 5,
    "authenticationWindowInSeconds": 60,
    "globalPermitLimit": 100,
    "globalWindowInSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "AllowedHosts": "*"
}
